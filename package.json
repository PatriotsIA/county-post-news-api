{
  "name": "county-post-news-api",
  "version": "1.0.0",
  "description": "Cheap AWS Lambda news aggregation API for The County Post.",
  "type": "module",
  "main": "dist/src/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/local-server.ts",
    "start": "node dist/src/local-server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "update:populations": "node scripts/update-county-populations.mjs",
    "audit:county-news": "tsx scripts/news-coverage/cli.ts",
    "audit:county-news:canvas": "tsx scripts/news-coverage/generate-canvas.ts",
    "atlas:ingest": "tsx scripts/atlas/cli.ts",
    "atlas:test": "vitest run tests/atlas-ingestion.test.ts tests/atlas-service.test.ts",
    "update:places": "node scripts/update-county-places.mjs"
  },
  "keywords": [
    "aws-lambda",
    "rss",
    "news",
    "the-county-post"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-presigned-post": "^3.1107.0",
    "@nickgraffis/us-counties": "^0.0.2",
    "@turf/centroid": "^7.3.5",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "stripe": "^22.4.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.0.1",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
